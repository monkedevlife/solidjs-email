{
  "name": "@solidjs-email/dev-server",
  "version": "2.0.0",
  "description": "Development server for previewing SolidJS email templates",
  "type": "module",
  "bin": {
    "solidjs-email": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "src/**",
    "vite.config.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown src/cli.ts src/index.ts --format esm",
    "build:watch": "tsdown src/cli.ts src/index.ts --format esm --watch",
    "dev": "EMAILS_DIR=../../examples/default/emails vite dev --port 6008"
  },
  "keywords": [
    "solidjs",
    "email",
    "preview",
    "dev-server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@solidjs-email/components": "workspace:*",
    "@solidjs-email/render": "workspace:*",
    "@solidjs/web": "^2.0.0-rc.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.168.34",
    "@tanstack/solid-router": "^2.0.0-rc.1",
    "cac": "^6.7.14",
    "picocolors": "^1.1.0",
    "solid-js": "^2.0.0-rc.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@solidjs/start-devtools": "1.0.0-next.3",
    "@solidjs/vite-plugin": "^3.0.0-next.31",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "author": "solidjs-email",
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs-email/solidjs-email.git",
    "directory": "packages/dev-server"
  },
  "publishConfig": {
    "access": "public"
  }
}
